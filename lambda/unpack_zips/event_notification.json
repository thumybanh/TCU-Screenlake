{
  "LambdaFunctionConfigurations": [
    {
      "Id": "unpack-lf-zips",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-2:951662621099:function:screenlake-unpack-zips",
      "Events": [
        "s3:ObjectCreated:*"
      ],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "prefix",
              "Value": "academia/tenant/"
            },
            {
              "Name": "suffix",
              "Value": ".zip"
            }
          ]
        }
      }
    },
    {
      "Id": "unpack-rs-zips",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-2:951662621099:function:screenlake-unpack-zips",
      "Events": [
        "s3:ObjectCreated:*"
      ],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "prefix",
              "Value": "academia/testing/tenant/"
            },
            {
              "Name": "suffix",
              "Value": ".zip"
            }
          ]
        }
      }
    }
  ]
}
